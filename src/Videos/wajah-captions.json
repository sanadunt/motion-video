[
  {
    "clip": "01-hook",
    "start": 1.28,
    "end": 7.98,
    "text": "Seorang perempuan berhenti di depan lukisan tua,"
  },
  {
    "clip": "01-hook",
    "start": 8.06,
    "end": 10.62,
    "text": "lalu menoleh ke pacarnya."
  },
  {
    "clip": "01-hook",
    "start": 11.92,
    "end": 12.98,
    "text": "\"Itu kamu.\""
  },
  {
    "clip": "02-lukisan",
    "start": 14.21,
    "end": 18.53,
    "text": "Tahun seribu lima ratus enam puluh dua."
  },
  {
    "clip": "02-lukisan",
    "start": 19.88,
    "end": 22.02,
    "text": "Pelukisnya tak dikenal."
  },
  {
    "clip": "02-lukisan",
    "start": 23.24,
    "end": 25.11,
    "text": "Prianya juga."
  },
  {
    "clip": "03-legenda",
    "start": 26,
    "end": 30.13,
    "text": "Konon, siapa yang bertemu kembarannya"
  },
  {
    "clip": "03-legenda",
    "start": 30.77,
    "end": 33.15,
    "text": "tak lama lagi mati."
  },
  {
    "clip": "03-legenda",
    "start": 33.46,
    "end": 39.72,
    "text": "Penyair Percy Shelley mengaku berpapasan dengan dirinya sendiri."
  },
  {
    "clip": "03-legenda",
    "start": 39.8,
    "end": 43.86,
    "text": "Beberapa minggu kemudian ia tenggelam."
  },
  {
    "clip": "04-dna",
    "start": 45.16,
    "end": 47.62,
    "text": "Kata sains: kebetulan."
  },
  {
    "clip": "04-dna",
    "start": 48.8,
    "end": 52.46,
    "text": "Tapi saat orang asing berwajah kembar diperiksa,"
  },
  {
    "clip": "04-dna",
    "start": 53.31,
    "end": 54.9,
    "text": "kode genetik mereka"
  },
  {
    "clip": "04-dna",
    "start": 55.16,
    "end": 56.78,
    "text": "sebagian sama."
  },
  {
    "clip": "05-penutup",
    "start": 57.8,
    "end": 59.04,
    "text": "Kebetulan"
  },
  {
    "clip": "05-penutup",
    "start": 59.91,
    "end": 62.82,
    "text": "atau di suatu tempat,"
  },
  {
    "clip": "05-penutup",
    "start": 63.58,
    "end": 66.62,
    "text": "seseorang sedang memakai wajahmu?"
  }
