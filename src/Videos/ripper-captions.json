[
  {
    "clip": "01-hook",
    "start": 1,
    "end": 3.3,
    "text": "Lima perempuan."
  },
  {
    "clip": "01-hook",
    "start": 4.2,
    "end": 5.89,
    "text": "Sebelas minggu."
  },
  {
    "clip": "01-hook",
    "start": 6.95,
    "end": 8.35,
    "text": "Dan satu surat"
  },
  {
    "clip": "01-hook",
    "start": 9.1,
    "end": 12.02,
    "text": "yang ditulis dengan tinta merah."
  },
  {
    "clip": "02-setup",
    "start": 13.37,
    "end": 19.52,
    "text": "Tiga puluh satu Agustus, 1888."
  },
  {
    "clip": "02-setup",
    "start": 19.6,
    "end": 21.82,
    "text": "Pukul tiga empat puluh pagi."
  },
  {
    "clip": "02-setup",
    "start": 22.57,
    "end": 25.19,
    "text": "Buck's Row, London Timur."
  },
  {
    "clip": "02-setup",
    "start": 26.18,
    "end": 28.1,
    "text": "Mary Ann Nichols."
  },
  {
    "clip": "02-setup",
    "start": 29.19,
    "end": 30.77,
    "text": "Delapan hari kemudian"
  },
  {
    "clip": "02-setup",
    "start": 31.31,
    "end": 32.42,
    "text": "Annie Chapman."
  },
  {
    "clip": "02-setup",
    "start": 33.17,
    "end": 35.53,
    "text": "Lalu, dalam satu malam yang sama"
  },
  {
    "clip": "02-setup",
    "start": 35.96,
    "end": 37.37,
    "text": "dua sekaligus."
  },
  {
    "clip": "02-setup",
    "start": 37.91,
    "end": 39.12,
    "text": "Elizabeth Stride."
  },
  {
    "clip": "02-setup",
    "start": 39.77,
    "end": 41.3,
    "text": "Catherine Eddowes."
  },
  {
    "clip": "03-grafiti",
    "start": 42.58,
    "end": 45.4,
    "text": "Di Goulston Street,"
  },
  {
    "clip": "03-grafiti",
    "start": 45.48,
    "end": 48.49,
    "text": "di atas sepotong celemek yang basah,"
  },
  {
    "clip": "03-grafiti",
    "start": 49.34,
    "end": 52.84,
    "text": "seseorang menulis dengan kapur di dinding."
  },
  {
    "clip": "03-grafiti",
    "start": 53.9,
    "end": 57.21,
    "text": "Polisi menghapusnya sebelum matahari terbit."
  },
  {
    "clip": "03-grafiti",
    "start": 58.11,
    "end": 60.5,
    "text": "Tidak ada yang sempat memotretnya."
  },
  {
    "clip": "04-surat",
    "start": 61.77,
    "end": 63.64,
    "text": "Enam belas Oktober."
  },
  {
    "clip": "04-surat",
    "start": 64.77,
    "end": 70.05,
    "text": "Sebuah kotak kecil tiba di meja George Lusk."
  },
  {
    "clip": "04-surat",
    "start": 71.53,
    "end": 72.65,
    "text": "Di dalamnya"
  },
  {
    "clip": "04-surat",
    "start": 73.18,
    "end": 75.83,
    "text": "separuh ginjal manusia"
  },
  {
    "clip": "04-surat",
    "start": 76.75,
    "end": 78.51,
    "text": "dan sepucuk surat."
  },
  {
    "clip": "04-surat",
    "start": 80.05,
    "end": 83,
    "text": "Surat itu tidak punya alamat pengirim."
  },
  {
    "clip": "04-surat",
    "start": 84.05,
    "end": 86.68,
    "text": "Hanya dua kata di bagian atas."
  },
  {
    "clip": "04-surat",
    "start": 87.69,
    "end": 88.92,
    "text": "From Hell."
  },
  {
    "clip": "05-kelly",
    "start": 91.34,
    "end": 93.34,
    "text": "Sembilan November."
  },
  {
    "clip": "05-kelly",
    "start": 94.44,
    "end": 95.62,
    "text": "Miller's Court."
  },
  {
    "clip": "05-kelly",
    "start": 96.87,
    "end": 98.71,
    "text": "Mary Jane Kelly."
  },
  {
    "clip": "05-kelly",
    "start": 99.72,
    "end": 101.08,
    "text": "Yang terakhir"
  },
  {
    "clip": "05-kelly",
    "start": 102.04,
    "end": 103.79,
    "text": "tidak ditemukan di jalan."
  },
  {
    "clip": "05-kelly",
    "start": 105.29,
    "end": 108.89,
    "text": "Dia ditemukan di dalam kamarnya sendiri."
  },
  {
    "clip": "05-kelly",
    "start": 110.11,
    "end": 110.66,
    "text": "Pintunya"
  },
  {
    "clip": "05-kelly",
    "start": 110.74,
    "end": 111.64,
    "text": "terkunci."
  },
  {
    "clip": "06-penutup",
    "start": 113.77,
    "end": 116.48,
    "text": "Dia tidak pernah tertangkap."
  },
  {
    "clip": "06-penutup",
    "start": 117.63,
    "end": 120.01,
    "text": "Tidak pernah diidentifikasi."
  },
  {
    "clip": "06-penutup",
    "start": 121.33,
    "end": 123.4,
    "text": "Surat-suratnya berhenti datang."
  },
  {
    "clip": "06-penutup",
    "start": 124.41,
    "end": 127.02,
    "text": "Orang-orang bilang dia berhenti."
  },
  {
    "clip": "06-penutup",
    "start": 128.31,
    "end": 130.8,
    "text": "Tapi tidak ada yang pernah bilang"
  },
  {
    "clip": "06-penutup",
    "start": 131.33,
    "end": 132.43,
    "text": "dia selesai."
  }
]