[
  {
    "clip": "01-hook",
    "start": 0.79,
    "end": 4.27,
    "text": "Kalau nomor yang meneleponmu berwarna merah,"
  },
  {
    "clip": "01-hook",
    "start": 4.95,
    "end": 5.86,
    "text": "jangan diangkat."
  },
  {
    "clip": "02-sebar",
    "start": 6.16,
    "end": 9.08,
    "text": "Mei dua ribu delapan."
  },
  {
    "clip": "02-sebar",
    "start": 9.16,
    "end": 14.96,
    "text": "SMS berantai itu menyebar dari Riau sampai ke Jawa."
  },
  {
    "clip": "03-konon",
    "start": 15.26,
    "end": 19.82,
    "text": "Konon, peneleponnya dukun ilmu hitam."
  },
  {
    "clip": "03-konon",
    "start": 20.42,
    "end": 23.84,
    "text": "Katanya, tujuh orang tewas."
  },
  {
    "clip": "04-resmi",
    "start": 24.23,
    "end": 26.83,
    "text": "Polisi: kabar bohong."
  },
  {
    "clip": "04-resmi",
    "start": 27.43,
    "end": 30.13,
    "text": "Tak satu pun kematian terbukti."
  },
  {
    "clip": "05-iseng",
    "start": 30.7,
    "end": 37.53,
    "text": "Sepekan kemudian, pengirimnya disebut sudah diamankan polisi di Riau."
  },
  {
    "clip": "05-iseng",
    "start": 37.61,
    "end": 39.7,
    "text": "Motifnya, iseng."
  },
  {
    "clip": "05-iseng",
    "start": 40.47,
    "end": 43.17,
    "text": "Namanya tak pernah diumumkan."
  },
  {
    "clip": "06-sakit",
    "start": 43.27,
    "end": 46.65,
    "text": "Tapi beberapa orang mengaku jatuh sakit."
  },
  {
    "clip": "06-sakit",
    "start": 47.3,
    "end": 52.71,
    "text": "Di Jakarta, seorang pria mengaku layar ponselnya memerah,"
  },
  {
    "clip": "06-sakit",
    "start": 53.25,
    "end": 54.52,
    "text": "lalu tangannya kejang."
  },
  {
    "clip": "06-sakit",
    "start": 55.2,
    "end": 57.47,
    "text": "Pejabat menyebutnya sugesti."
  },
  {
    "clip": "07-dunia",
    "start": 57.57,
    "end": 60.42,
    "text": "Dan pesan ini tidak baru."
  },
  {
    "clip": "07-dunia",
    "start": 61.08,
    "end": 63.51,
    "text": "Dua ribu empat, Nigeria."
  },
  {
    "clip": "07-dunia",
    "start": 64.1,
    "end": 66.36,
    "text": "Dua ribu tujuh, Pakistan:"
  },
  {
    "clip": "07-dunia",
    "start": 66.97,
    "end": 69.38,
    "text": "nomornya sudah berwarna merah."
  },
  {
    "clip": "08-tutup",
    "start": 69.63,
    "end": 72.67,
    "text": "Kalau pengirimnya tertangkap di Riau,"
  },
  {
    "clip": "08-tutup",
    "start": 73.46,
    "end": 77.28,
    "text": "siapa yang menulisnya empat tahun lebih awal,"
  },
  {
    "clip": "08-tutup",
    "start": 77.85,
    "end": 78.87,
    "text": "di benua lain?"
  },
  {
    "clip": "08-tutup",
    "start": 80.04,
    "end": 80.94,
    "text": "Malam ini,"
  },
  {
    "clip": "08-tutup",
    "start": 81.6,
    "end": 82.96,
    "text": "kalau nomornya merah,"
  },
  {
    "clip": "08-tutup",
    "start": 83.68,
    "end": 84.55,
    "text": "kamu angkat?"
  }
