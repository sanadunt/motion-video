[
  {
    "clip": "01-hook",
    "start": 1.44,
    "end": 2.4,
    "text": "Lima perempuan."
  },
  {
    "clip": "01-hook",
    "start": 5,
    "end": 5.96,
    "text": "Sebelas minggu."
  },
  {
    "clip": "01-hook",
    "start": 7.78,
    "end": 9.02,
    "text": "Dan satu surat"
  },
  {
    "clip": "01-hook",
    "start": 9.76,
    "end": 11.56,
    "text": "yang ditulis dengan tinta merah."
  },
  {
    "clip": "02-setup",
    "start": 14.28,
    "end": 16.08,
    "text": "Tiga puluh satu Agustus, 1888."
  },
  {
    "clip": "02-setup",
    "start": 21.52,
    "end": 23.32,
    "text": "Pukul tiga empat puluh pagi."
  },
  {
    "clip": "02-setup",
    "start": 26.58,
    "end": 28.1,
    "text": "Buck's Row, London Timur."
  },
  {
    "clip": "02-setup",
    "start": 29.58,
    "end": 30.82,
    "text": "Mary Ann Nichols."
  },
  {
    "clip": "02-setup",
    "start": 31.54,
    "end": 32.78,
    "text": "Delapan hari kemudian"
  },
  {
    "clip": "02-setup",
    "start": 34.06,
    "end": 34.56,
    "text": "Annie Chapman."
  },
  {
    "clip": "02-setup",
    "start": 34.68,
    "end": 36.76,
    "text": "Lalu, dalam satu malam yang sama"
  },
  {
    "clip": "02-setup",
    "start": 38.26,
    "end": 38.69,
    "text": "dua sekaligus."
  },
  {
    "clip": "02-setup",
    "start": 38.74,
    "end": 39.7,
    "text": "Elizabeth Stride."
  },
  {
    "clip": "02-setup",
    "start": 40.72,
    "end": 41.68,
    "text": "Catherine Eddowes."
  },
  {
    "clip": "03-grafiti",
    "start": 42.78,
    "end": 44.02,
    "text": "Di Goulston Street,"
  },
  {
    "clip": "03-grafiti",
    "start": 45.58,
    "end": 47.66,
    "text": "di atas sepotong celemek yang basah,"
  },
  {
    "clip": "03-grafiti",
    "start": 49.44,
    "end": 51.52,
    "text": "seseorang menulis dengan kapur di dinding."
  },
  {
    "clip": "03-grafiti",
    "start": 54.02,
    "end": 55.82,
    "text": "Polisi menghapusnya sebelum matahari terbit."
  },
  {
    "clip": "03-grafiti",
    "start": 58.2,
    "end": 60,
    "text": "Tidak ada yang sempat memotretnya."
  },
  {
    "clip": "04-surat",
    "start": 62.3,
    "end": 63.54,
    "text": "Enam belas Oktober."
  },
  {
    "clip": "04-surat",
    "start": 67.08,
    "end": 69.72,
    "text": "Sebuah kotak kecil tiba di meja George Lusk."
  },
  {
    "clip": "04-surat",
    "start": 74.28,
    "end": 75.04,
    "text": "Di dalamnya"
  },
  {
    "clip": "04-surat",
    "start": 75.16,
    "end": 76.4,
    "text": "separuh ginjal manusia"
  },
  {
    "clip": "04-surat",
    "start": 78.02,
    "end": 79.26,
    "text": "dan sepucuk surat."
  },
  {
    "clip": "04-surat",
    "start": 81.2,
    "end": 83.28,
    "text": "Surat itu tidak punya alamat pengirim."
  },
  {
    "clip": "04-surat",
    "start": 84.68,
    "end": 86.76,
    "text": "Hanya dua kata di bagian atas."
  },
  {
    "clip": "04-surat",
    "start": 88.6,
    "end": 89.5,
    "text": "From Hell."
  },
  {
    "clip": "05-kelly",
    "start": 91.54,
    "end": 92.5,
    "text": "Sembilan November."
  },
  {
    "clip": "05-kelly",
    "start": 94.76,
    "end": 95.72,
    "text": "Miller's Court."
  },
  {
    "clip": "05-kelly",
    "start": 97.12,
    "end": 98.36,
    "text": "Mary Jane Kelly."
  },
  {
    "clip": "05-kelly",
    "start": 99.98,
    "end": 100.94,
    "text": "Yang terakhir"
  },
  {
    "clip": "05-kelly",
    "start": 102.24,
    "end": 103.76,
    "text": "tidak ditemukan di jalan."
  },
  {
    "clip": "05-kelly",
    "start": 105.48,
    "end": 107.56,
    "text": "Dia ditemukan di dalam kamarnya sendiri."
  },
  {
    "clip": "05-kelly",
    "start": 110.18,
    "end": 110.82,
    "text": "Pintunya"
  },
  {
    "clip": "05-kelly",
    "start": 110.94,
    "end": 111.62,
    "text": "terkunci."
  },
  {
    "clip": "06-penutup",
    "start": 114.14,
    "end": 115.66,
    "text": "Dia tidak pernah tertangkap."
  },
  {
    "clip": "06-penutup",
    "start": 117.78,
    "end": 119.02,
    "text": "Tidak pernah diidentifikasi."
  },
  {
    "clip": "06-penutup",
    "start": 121.54,
    "end": 122.78,
    "text": "Surat-suratnya berhenti datang."
  },
  {
    "clip": "06-penutup",
    "start": 124.74,
    "end": 126.26,
    "text": "Orang-orang bilang dia berhenti."
  },
  {
    "clip": "06-penutup",
    "start": 128.6,
    "end": 130.68,
    "text": "Tapi tidak ada yang pernah bilang"
  },
  {
    "clip": "06-penutup",
    "start": 131.62,
    "end": 132.5,
    "text": "dia selesai."
  }
]