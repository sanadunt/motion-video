[
  {
    "clip": "01-hook",
    "start": 0.74,
    "end": 5.14,
    "text": "Kalau kamu menghitung tiang listrik di jalan pulang"
  },
  {
    "clip": "01-hook",
    "start": 6.06,
    "end": 10.69,
    "text": "dan jumlahnya bertambah satu, jangan hitung lagi."
  },
  {
    "clip": "02-ciri",
    "start": 11.44,
    "end": 17.39,
    "text": "Dari jauh, ia tampak seperti tiang telepon tua."
  },
  {
    "clip": "02-ciri",
    "start": 18.19,
    "end": 31.29,
    "text": "Dari dekat: daging busuk dan besi berkarat, menyatu. Tanpa mata. Di tempat kepala, dua pengeras suara."
  },
  {
    "clip": "03a-siaran",
    "start": 31.88,
    "end": 34.86,
    "text": "Pengeras suara itu bersiaran."
  },
  {
    "clip": "03a-siaran",
    "start": 35.49,
    "end": 40.05,
    "text": "Potongan kata, statis, sirene."
  },
  {
    "clip": "k1-siaran",
    "start": 40.58,
    "end": 44.13,
    "text": "Selamat malam. Jalan pulang ditutup."
  },
  {
    "clip": "03b-kenal",
    "start": 44.78,
    "end": 45.78,
    "text": "Dan kadang,"
  },
  {
    "clip": "03b-kenal",
    "start": 46.38,
    "end": 48.88,
    "text": "suara orang yang kamu kenal."
  },
  {
    "clip": "04-pendaki",
    "start": 49.38,
    "end": 54.91,
    "text": "Seorang pendaki merekam jalan turun dari Bukit Karangsunyi."
  },
  {
    "clip": "04-pendaki",
    "start": 55.69,
    "end": 59.28,
    "text": "Ia menghitung tiang, untuk mengusir takut."
  },
  {
    "clip": "b1-hitung",
    "start": 59.69,
    "end": 62.18,
    "text": "Dua puluh satu."
  },
  {
    "clip": "b1-hitung",
    "start": 63.13,
    "end": 64.08,
    "text": "Dua puluh dua."
  },
  {
    "clip": "b2-tambah",
    "start": 64.53,
    "end": 65.51,
    "text": "Dua puluh tiga."
  },
  {
    "clip": "05-hilang",
    "start": 68.02,
    "end": 70.24,
    "text": "Kameranya ditemukan."
  },
  {
    "clip": "05-hilang",
    "start": 71.34,
    "end": 72.75,
    "text": "Pendakinya tidak."
  },
  {
    "clip": "06-satu",
    "start": 73.55,
    "end": 75.24,
    "text": "Ia hanya ada satu."
  },
  {
    "clip": "06-satu",
    "start": 76.43,
    "end": 79.71,
    "text": "Tak ada yang tahu dari mana asalnya."
  },
  {
    "clip": "n7-tiru",
    "start": 80.45,
    "end": 81.54,
    "text": "hitung lagi."
  }
]