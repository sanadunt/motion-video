{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "types": [
      "node",
      "@types/web"
    ]
  },
  "exclude": [
    "node_modules",
    "whisper.cpp",
    "tmp",
    "out"
  ],
  "include": [
    "src",
    "scripts",
    "remotion.config.ts"
  ]
}
