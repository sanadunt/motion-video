[
  {
    "clip": "01-hook",
    "start": 1,
    "end": 3.19,
    "text": "Lima perempuan."
  },
  {
    "clip": "01-hook",
    "start": 4.2,
    "end": 5.76,
    "text": "Sebelas minggu."
  },
  {
    "clip": "01-hook",
    "start": 6.95,
    "end": 8.57,
    "text": "Dan satu surat"
  },
  {
    "clip": "01-hook",
    "start": 9.1,
    "end": 12.2,
    "text": "yang ditulis dengan tinta merah."
  },
  {
    "clip": "02-setup",
    "start": 13,
    "end": 18.82,
    "text": "Tiga puluh satu Agustus, 1888."
  },
  {
    "clip": "02-setup",
    "start": 19.6,
    "end": 21.67,
    "text": "Pukul tiga empat puluh pagi."
  },
  {
    "clip": "02-setup",
    "start": 22.57,
    "end": 23.84,
    "text": "Buck's Row, London Timur."
  },
  {
    "clip": "02-setup",
    "start": 23.94,
    "end": 25.13,
    "text": "Mary Ann Nichols."
  },
  {
    "clip": "02-setup",
    "start": 26.18,
    "end": 27.95,
    "text": "Delapan hari kemudian"
  },
  {
    "clip": "02-setup",
    "start": 29.19,
    "end": 30.62,
    "text": "Annie Chapman."
  },
  {
    "clip": "02-setup",
    "start": 31.31,
    "end": 33.07,
    "text": "Lalu, dalam satu malam yang sama"
  },
  {
    "clip": "02-setup",
    "start": 33.17,
    "end": 37.22,
    "text": "dua sekaligus."
  },
  {
    "clip": "02-setup",
    "start": 37.91,
    "end": 38.97,
    "text": "Elizabeth Stride."
  },
  {
    "clip": "02-setup",
    "start": 39.77,
    "end": 41.52,
    "text": "Catherine Eddowes."
  },
  {
    "clip": "03-grafiti",
    "start": 42.3,
    "end": 44.53,
    "text": "Di Goulston Street,"
  },
  {
    "clip": "03-grafiti",
    "start": 45.48,
    "end": 48.55,
    "text": "di atas sepotong celemek yang basah,"
  },
  {
    "clip": "03-grafiti",
    "start": 49.34,
    "end": 52.73,
    "text": "seseorang menulis dengan kapur di dinding."
  },
  {
    "clip": "03-grafiti",
    "start": 53.9,
    "end": 57.31,
    "text": "Polisi menghapusnya sebelum matahari terbit."
  },
  {
    "clip": "03-grafiti",
    "start": 58.11,
    "end": 60.7,
    "text": "Tidak ada yang sempat memotretnya."
  },
  {
    "clip": "04-surat",
    "start": 61.5,
    "end": 63.51,
    "text": "Enam belas Oktober."
  },
  {
    "clip": "04-surat",
    "start": 64.77,
    "end": 69.91,
    "text": "Sebuah kotak kecil tiba di meja George Lusk."
  },
  {
    "clip": "04-surat",
    "start": 71.53,
    "end": 72.51,
    "text": "Di dalamnya"
  },
  {
    "clip": "04-surat",
    "start": 73.16,
    "end": 75.69,
    "text": "separuh ginjal manusia"
  },
  {
    "clip": "04-surat",
    "start": 76.75,
    "end": 78.36,
    "text": "dan sepucuk surat."
  },
  {
    "clip": "04-surat",
    "start": 80.05,
    "end": 82.87,
    "text": "Surat itu tidak punya alamat pengirim."
  },
  {
    "clip": "04-surat",
    "start": 84.05,
    "end": 86.54,
    "text": "Hanya dua kata di bagian atas."
  },
  {
    "clip": "04-surat",
    "start": 87.69,
    "end": 89.22,
    "text": "From Hell."
  },
  {
    "clip": "05-kelly",
    "start": 91.1,
    "end": 93.19,
    "text": "Sembilan November."
  },
  {
    "clip": "05-kelly",
    "start": 93.83,
    "end": 94.34,
    "text": "Miller's Court."
  },
  {
    "clip": "05-kelly",
    "start": 94.44,
    "end": 95.63,
    "text": "Mary Jane Kelly."
  },
  {
    "clip": "05-kelly",
    "start": 96.87,
    "end": 98.56,
    "text": "Yang terakhir"
  },
  {
    "clip": "05-kelly",
    "start": 99.72,
    "end": 101.19,
    "text": "tidak ditemukan di jalan."
  },
  {
    "clip": "05-kelly",
    "start": 102.04,
    "end": 104.07,
    "text": "Dia ditemukan di dalam kamarnya sendiri."
  },
  {
    "clip": "05-kelly",
    "start": 105.29,
    "end": 108.74,
    "text": "Pintunya"
  },
  {
    "clip": "05-kelly",
    "start": 110.11,
    "end": 111.66,
    "text": "terkunci."
  },
  {
    "clip": "06-penutup",
    "start": 113.5,
    "end": 116.71,
    "text": "Dia tidak pernah tertangkap."
  },
  {
    "clip": "06-penutup",
    "start": 117.21,
    "end": 119.87,
    "text": "Tidak pernah diidentifikasi."
  },
  {
    "clip": "06-penutup",
    "start": 121.32,
    "end": 123.25,
    "text": "Surat-suratnya berhenti datang."
  },
  {
    "clip": "06-penutup",
    "start": 124.41,
    "end": 126.88,
    "text": "Orang-orang bilang dia berhenti."
  },
  {
    "clip": "06-penutup",
    "start": 128.31,
    "end": 130.68,
    "text": "Tapi tidak ada yang pernah bilang"
  },
  {
    "clip": "06-penutup",
    "start": 131.33,
    "end": 132.66,
    "text": "dia selesai."
  }
]